<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Access Restricted</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .access-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            padding: 3rem;
            max-width: 600px;
            text-align: center;
        }
        .lock-icon {
            font-size: 5rem;
            color: #667eea;
            margin-bottom: 1rem;
        }
        h1 {
            color: #333;
            margin-bottom: 1rem;
        }
        .info-text {
            color: #666;
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }
        .discord-logo {
            width: 40px;
            height: 40px;
            margin-right: 10px;
            vertical-align: middle;
        }
        .command-box {
            background: #f8f9fa;
            border-left: 4px solid #667eea;
            padding: 1rem;
            margin: 1.5rem 0;
            border-radius: 5px;
            font-family: monospace;
            font-size: 1.2rem;
            color: #333;
        }
    </style>
</head>

<body>
    <div class="access-card">
        <div class="lock-icon">🔒</div>
        <h1>Access Restricted</h1>

        <p class="info-text">
            This website is only accessible to authorized Discord server members.
        </p>

        <p class="info-text">
            To access this website, use the <strong>/quotes</strong> command in the After Dark Discord server.
            You'll receive a private link that will grant you access for 8 hours.
        </p>

        <hr style="margin: 2rem 0;">

        {{#if devMode}}
        <div style="margin-top: 2rem; padding: 1.5rem; background: #fff3cd; border-radius: 10px; border: 2px solid #ffc107;">
            <h5 style="color: #856404; margin-bottom: 1rem;">🔧 Developer Mode</h5>
            <form method="POST" action="/dev-login">
                <!-- Honeypot field - hidden from real users but visible to bots -->
                <div style="position: absolute; left: -9999px; opacity: 0; pointer-events: none;" aria-hidden="true">
                    <label for="website">Website</label>
                    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" name="password" placeholder="Enter dev password" required>
                </div>
                <button type="submit" class="btn btn-warning">Dev Login</button>
            </form>
            {{#if error}}
            <div class="alert alert-danger mt-3" role="alert">
                Invalid password
            </div>
            {{/if}}
            {{#if rateLimited}}
            <div class="alert alert-warning mt-3" role="alert">
                Too many login attempts. Please try again in 15 minutes.
            </div>
            {{/if}}
        </div>
        {{/if}}

        <p style="color: #999; font-size: 0.9rem; margin-top: 1.5rem;">
            🎭 After Dark Quotes Rating System
        </p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
